FROM google/cloud-sdk:367.0.0@sha256:f5575b1258033019c6c44329a8179abb8d91110431d3c5c540fdafc8a8f0b74e


# Install dependencies
RUN apt-get update && \
    apt-get install -y python3-pip vim curl 

RUN curl -fsSLo /tmp/helm.tar.gz https://get.helm.sh/helm-v3.18.6-linux-amd64.tar.gz && \
    echo "3f43c0aa57243852dd542493a0f54f1396c0bc8ec7296bbb2c01e802010819ce  /tmp/helm.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/helm.tar.gz -C /tmp && \
    install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm && \
    rm -rf /tmp/helm.tar.gz /tmp/linux-amd64

COPY requirements.copy.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

COPY data-extraction/run_copy_merlin.sh /script/
COPY inference /script

WORKDIR /script
